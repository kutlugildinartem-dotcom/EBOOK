# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Portable static build
/dist-static/

# Rebuilt from the included source dictionary and pinned npm packages
/public/dictionary/[a-z].json
/public/dictionary/_.json
/public/dictionary/fast-*.json
/public/dictionary/fast-*.json.gz
/public/translation-runtime/
/public/translation-worker.js
/public/pdf.worker.min.mjs

# Android build outputs and signing material
/android/.gradle/
/android/**/build/
/android/app/src/main/assets/
/android/local.properties
*.jks
*.keystore
*.p12
